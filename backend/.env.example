PORT=4000
JWT_SECRET=ganti-dengan-random-panjang
JWT_TTL=8h
# true kalau backend di belakang HTTPS
COOKIE_SECURE=false

# ---- Fabric ----
FABRIC_CHAINCODE=sandichain
# klasifikasi -> channel (dibuat oleh scripts/network-up.sh)
CHANNEL_BIASA=ch-umum
CHANNEL_TERBATAS=ch-umum
CHANNEL_RAHASIA=ch-rahasia
CHANNEL_SANGAT_RAHASIA=ch-rahasia
# path ke fabric-samples/test-network (untuk TLS CA peer)
FABRIC_TEST_NETWORK=../fabric-samples/test-network
WALLET_DIR=./wallet
USERS_FILE=./config/users.json
# user layanan (role=auditor) yang dipakai listener event
SENTINEL_USER=sentinel

# ---- Enkripsi (vault | local) ----
KMS_MODE=vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_TRANSIT_KEY=sandichain
# hanya untuk KMS_MODE=local: 32 byte base64 (openssl rand -base64 32)
LOCAL_KEK=

# ---- Object storage S3-compatible (SeaweedFS di dev; bisa MinIO/Ceph) ----
S3_ENDPOINT=localhost
S3_PORT=8333
S3_USE_SSL=false
S3_ACCESS_KEY=sandiadmin
S3_SECRET_KEY=sandiadmin123
S3_BUCKET=sandi-docs

# ---- PostgreSQL ----
DATABASE_URL=postgres://sandi:sandi123@localhost:5432/sandichain

# ---- Alert ----
# POST JSON ke URL ini tiap ada alert (Wazuh/Telegram bot/SOAR). Kosongkan untuk mematikan.
ALERT_WEBHOOK_URL=
# file JSON-lines untuk di-tail agent Wazuh
ALERT_LOG_FILE=./logs/alerts.log
