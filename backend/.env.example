PORT=4000
JWT_SECRET=ganti-dengan-random-panjang
JWT_TTL=8h
# true kalau backend di belakang HTTPS
COOKIE_SECURE=false

# ---- Fabric ----
FABRIC_CHAINCODE=sandichain
# klasifikasi -> channel (dibuat oleh scripts/network-up.sh)
CHANNEL_BIASA=ch-umum
CHANNEL_TERBATAS=ch-umum
CHANNEL_RAHASIA=ch-rahasia
CHANNEL_SANGAT_RAHASIA=ch-rahasia
# path ke fabric-samples/test-network (untuk TLS CA peer)
FABRIC_TEST_NETWORK=../fabric-samples/test-network
WALLET_DIR=./wallet
# server = kunci privat personel di wallet/ backend (dev sederhana)
# client = kunci di perangkat personel; backend hanya menitipkan pesan untuk ditandatangani.
#          Setelah mengubah nilai ini jalankan ulang: npm run enroll (menerbitkan kartu di CARDS_DIR)
SIGNING_MODE=server
CARDS_DIR=./cards
USERS_FILE=./config/users.json
# user layanan (role=auditor) yang dipakai listener event
SENTINEL_USER=sentinel

# ---- Enkripsi (vault | local) ----
KMS_MODE=vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
# kunci "derived" untuk DEK baru (konteks channel/docId)
VAULT_DOC_KEY=sandichain-doc
# kunci lama (DEK yang dibuat sebelum VAULT_DOC_KEY ada)
VAULT_TRANSIT_KEY=sandichain
# ---- KeyGuard (pelepasan kunci berbasis bukti akses di ledger) ----
# Kosongkan KEYGUARD_URL untuk dev sederhana (backend decrypt langsung, butuh token root).
# Produksi: jalankan scripts/vault-setup.sh, isi nilai di bawah, lalu npm run keyguard:dev
# KEYGUARD_SECRET dipakai backend & KeyGuard. KEYGUARD_VAULT_TOKEN JANGAN di sini:
# taruh di backend/keyguard.env (hanya dibaca proses KeyGuard).
KEYGUARD_URL=
KEYGUARD_SECRET=
KEYGUARD_PORT=4100
KEYGUARD_USER=keyguard
KEYGUARD_GRANT_MAX_AGE_SEC=120
KEYGUARD_ALLOW_LEGACY_DEK=true

# hanya untuk KMS_MODE=local: 32 byte base64 (openssl rand -base64 32)
LOCAL_KEK=

# ---- Object storage S3-compatible (SeaweedFS di dev; bisa MinIO/Ceph) ----
S3_ENDPOINT=localhost
S3_PORT=8333
S3_USE_SSL=false
S3_ACCESS_KEY=sandiadmin
S3_SECRET_KEY=sandiadmin123
S3_BUCKET=sandi-docs

# ---- PostgreSQL ----
DATABASE_URL=postgres://sandi:sandi123@localhost:5432/sandichain

# ---- Viewer ----
# Render halaman menjadi gambar setelah diberi watermark (watermark menyatu dengan isi,
# teks tidak bisa disalin): rahasia = RAHASIA & SANGAT_RAHASIA saja | all | off
VIEW_RASTERIZE=rahasia
VIEW_RASTER_DPI=130
VIEW_MAX_PAGES=300

# ---- Alert ----
# POST JSON ke URL ini tiap ada alert (Wazuh/Telegram bot/SOAR). Kosongkan untuk mematikan.
ALERT_WEBHOOK_URL=
# file JSON-lines untuk di-tail agent Wazuh
ALERT_LOG_FILE=./logs/alerts.log
